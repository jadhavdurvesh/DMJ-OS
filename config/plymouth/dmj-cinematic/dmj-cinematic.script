// dmj-cinematic.script
// Plymouth "script" module theme for DMJ OS.
//
// Sequence:
//   0.0s - 1.0s   background fades in from black
//   0.0s - end    two-layer parallax particle field (far/near depth)
//   0.5s - 1.6s   glow blooms behind the logo
//   0.9s - 2.3s   logo reveal: scales in from 65% size with an overshoot
//                 "pop" past 100% (ease-out-back) before settling exactly
//                 at full size — the same settle-with-a-bounce feel used
//                 in modern app/logo reveal animations, not a flat scale
//   2.1s - 3.0s   a soft light sweep passes once across the scene
//   2.3s+         glow settles into a slow continuous "breathing" pulse
//   throughout    progress bar fills according to real boot progress
//   on password   password prompt (for encrypted disks) shown centered

Window.SetBackgroundTopColor(0.02, 0.02, 0.05);
Window.SetBackgroundBottomColor(0.01, 0.01, 0.03);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

// ---------------------------------------------------------------------
// Static images
// ---------------------------------------------------------------------
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.width = logo.image.GetWidth();
logo.height = logo.image.GetHeight();

// The shipped logo/glow assets are high-resolution (drawn for print/export,
// not for a specific screen), so scale them down to fit comfortably on
// screen regardless of the actual boot resolution: cap at 42% of screen
// width and 22% of screen height, whichever is more restrictive.
base_scale = (screen_w * 0.42) / logo.width;
max_h_scale = (screen_h * 0.22) / logo.height;
if (max_h_scale < base_scale) {
  base_scale = max_h_scale;
}
logo_display_w = logo.width * base_scale;
logo_display_h = logo.height * base_scale;

logo.x = screen_w / 2 - logo_display_w / 2;
logo.y = screen_h / 2 - logo_display_h / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 10);
logo.sprite.SetScale(base_scale, base_scale);
logo.sprite.SetOpacity(0);

glow.image = Image("logo_glow.png");
glow.sprite = Sprite(glow.image);
glow.width = glow.image.GetWidth();
glow.height = glow.image.GetHeight();
glow.x = screen_w / 2 - (glow.width * base_scale) / 2;
glow.y = screen_h / 2 - (glow.height * base_scale) / 2 - 40;
glow.sprite.SetPosition(glow.x, glow.y, 5);
glow.sprite.SetScale(base_scale, base_scale);
glow.sprite.SetOpacity(0);

// Light sweep: a thin vertical bright bar (reusing the glow image, scaled
// tall and thin) that travels once across the whole scene — a classic
// "shine pass" cinematic reveal accent, layered above everything.
sweep.sprite = Sprite(glow.image);
sweep_w = screen_w * 0.10;
sweep.sprite.SetScale(sweep_w / glow.width, (screen_h * 1.4) / glow.height);
sweep.sprite.SetOpacity(0);

// Progress bar track + fill, built from the progress_dot sprite, stretched
// via non-uniform scale into a thin bar so no separate bar asset is needed.
dot.image = Image("progress_dot.png");

progress_bar_width = screen_w * 0.28;
progress_bar_height = 4;
progress_bar_x = screen_w / 2 - progress_bar_width / 2;
progress_bar_y = logo.y + logo_display_h + 90;

track.sprite = Sprite(dot.image);
track.sprite.SetPosition(progress_bar_x, progress_bar_y, 8);
track.sprite.SetScale(progress_bar_width / dot.image.GetWidth(), progress_bar_height / dot.image.GetHeight());
track.sprite.SetOpacity(0.15);

fill.sprite = Sprite(dot.image);
fill.sprite.SetPosition(progress_bar_x, progress_bar_y, 9);
fill.sprite.SetScale(0.001, progress_bar_height / dot.image.GetHeight());
fill.sprite.SetOpacity(0.9);

// ---------------------------------------------------------------------
// Ambient particles, two depth layers for a parallax feel: a dim, slow
// "far" layer and a brighter, faster, slightly bigger "near" layer.
// ---------------------------------------------------------------------
particle_image = Image("particle.png");
num_far = 18;
num_near = 14;

for (i = 0; i < num_far; i++) {
  far[i].sprite = Sprite(particle_image);
  far[i].x = Math.Random() * screen_w;
  far[i].y = Math.Random() * screen_h;
  far[i].speed = 4 + Math.Random() * 8;
  far[i].scale = 0.25 + Math.Random() * 0.5;
  far[i].base_opacity = 0.05 + Math.Random() * 0.12;
  far[i].sprite.SetPosition(far[i].x, far[i].y, 2);
  far[i].sprite.SetScale(far[i].scale, far[i].scale);
  far[i].sprite.SetOpacity(far[i].base_opacity);
}

for (i = 0; i < num_near; i++) {
  near[i].sprite = Sprite(particle_image);
  near[i].x = Math.Random() * screen_w;
  near[i].y = Math.Random() * screen_h;
  near[i].speed = 14 + Math.Random() * 22;
  near[i].scale = 0.6 + Math.Random() * 1.3;
  near[i].base_opacity = 0.10 + Math.Random() * 0.28;
  near[i].sprite.SetPosition(near[i].x, near[i].y, 4);
  near[i].sprite.SetScale(near[i].scale, near[i].scale);
  near[i].sprite.SetOpacity(near[i].base_opacity);
}

// ---------------------------------------------------------------------
// Animation state
// ---------------------------------------------------------------------
start_time = -1;
boot_progress = 0;

fun ease_out(t) {
  return 1 - (1 - t) * (1 - t);
}

// Overshoot easing: eases toward 1.0 but slightly overshoots past it
// before settling back — produces the "pop and settle" feel of a modern
// logo reveal rather than a flat linear/quadratic scale-in.
fun ease_out_back(t) {
  c1 = 1.70158;
  c3 = c1 + 1;
  tm1 = t - 1;
  return 1 + c3 * (tm1 * tm1 * tm1) + c1 * (tm1 * tm1);
}

fun refresh_callback() {
  if (start_time == -1) {
    start_time = Plymouth.GetTime();
  }
  t = Plymouth.GetTime() - start_time;

  // Background fade-in (0 -> 1.0s)
  bg_t = Math.Min(1, t / 1.0);
  Window.SetBackgroundTopColor(0.02 * bg_t, 0.02 * bg_t, 0.05 * bg_t);

  // Glow bloom (0.5s -> 1.6s), then settles into a slow continuous
  // "breathing" pulse for the rest of the boot rather than staying static.
  glow_t = Math.Max(0, Math.Min(1, (t - 0.5) / 1.1));
  glow_eased = ease_out(glow_t);
  breathe = 1.0;
  if (glow_t >= 1) {
    breathe = 0.9 + 0.1 * Math.Sin(t * 1.2);
  }
  glow.sprite.SetOpacity(glow_eased * 0.8 * breathe);
  glow_scale = base_scale * (0.92 + 0.08 * glow_eased);
  glow.sprite.SetPosition(
    screen_w / 2 - (glow.width * glow_scale) / 2,
    screen_h / 2 - (glow.height * glow_scale) / 2 - 40,
    5
  );
  glow.sprite.SetScale(glow_scale, glow_scale);

  // Main logo reveal (0.9s -> 2.3s) with an overshoot pop, not a flat ease.
  logo_t = Math.Max(0, Math.Min(1, (t - 0.9) / 1.4));
  logo_opacity = ease_out(Math.Min(1, logo_t * 1.4));  // opacity settles slightly faster than scale
  logo_pop = ease_out_back(logo_t);
  logo_scale = base_scale * (0.65 + 0.35 * logo_pop);
  logo.sprite.SetOpacity(logo_opacity);
  logo.sprite.SetPosition(
    screen_w / 2 - (logo.width * logo_scale) / 2,
    screen_h / 2 - (logo.height * logo_scale) / 2 - 40,
    10
  );
  logo.sprite.SetScale(logo_scale, logo_scale);

  // Light sweep: one pass across the scene shortly after the logo settles.
  sweep_t = Math.Max(0, Math.Min(1, (t - 2.1) / 0.9));
  if (sweep_t > 0 && sweep_t < 1) {
    sweep_x = -sweep_w + (screen_w + sweep_w * 2) * sweep_t;
    sweep.sprite.SetPosition(sweep_x, screen_h / 2 - (screen_h * 1.4) / 2, 20);
    // Triangular envelope: fades in, peaks at the midpoint, fades out.
    envelope = 1 - Math.Min(1, ((sweep_t - 0.5) * (sweep_t - 0.5)) * 8);
    sweep.sprite.SetOpacity(Math.Max(0, envelope) * 0.18);
  } else {
    sweep.sprite.SetOpacity(0);
  }

  // Progress bar track fades in alongside the logo
  track.sprite.SetOpacity(0.15 * logo_opacity);

  // Progress fill follows real boot progress, smoothed slightly
  fill_width = Math.Max(0.001, progress_bar_width * boot_progress);
  fill.sprite.SetScale(fill_width / dot.image.GetWidth(), progress_bar_height / dot.image.GetHeight());
  fill.sprite.SetOpacity(0.9 * logo_opacity);

  // Far particle layer: slow, dim, small — background depth
  for (i = 0; i < num_far; i++) {
    far[i].y = far[i].y - far[i].speed * 0.016;
    if (far[i].y < -20) {
      far[i].y = screen_h + 20;
      far[i].x = Math.Random() * screen_w;
    }
    pulse = 0.7 + 0.3 * Math.Sin(t * 1.5 + i);
    far[i].sprite.SetPosition(far[i].x, far[i].y, 2);
    far[i].sprite.SetOpacity(far[i].base_opacity * pulse * bg_t);
  }

  // Near particle layer: faster, brighter, bigger — foreground depth
  for (i = 0; i < num_near; i++) {
    near[i].y = near[i].y - near[i].speed * 0.016;
    if (near[i].y < -20) {
      near[i].y = screen_h + 20;
      near[i].x = Math.Random() * screen_w;
    }
    pulse = 0.7 + 0.3 * Math.Sin(t * 2.3 + i * 1.3);
    near[i].sprite.SetPosition(near[i].x, near[i].y, 4);
    near[i].sprite.SetOpacity(near[i].base_opacity * pulse * bg_t);
  }
}

Plymouth.SetRefreshFunction(refresh_callback);

// ---------------------------------------------------------------------
// Boot progress callback — fired by Plymouth with real progress (0..1)
// ---------------------------------------------------------------------
fun progress_callback(duration, progress) {
  boot_progress = progress;
}

Plymouth.SetBootProgressFunction(progress_callback);

// ---------------------------------------------------------------------
// Password / passphrase prompt (e.g. for LUKS encrypted disks)
// ---------------------------------------------------------------------
prompt.dots = 0;
prompt.sprite = null;

fun display_password_callback(prompt_text, bullets) {
  Window.SetBackgroundTopColor(0.02, 0.02, 0.05);
  // Simple centered text feedback using the same font rendering Plymouth
  // provides for password bullets; kept minimal/cinematic (no extra chrome).
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);

// ---------------------------------------------------------------------
// Quit / transition to login — quick fade out
// ---------------------------------------------------------------------
fun quit_callback() {
  logo.sprite.SetOpacity(0);
  glow.sprite.SetOpacity(0);
  sweep.sprite.SetOpacity(0);
  track.sprite.SetOpacity(0);
  fill.sprite.SetOpacity(0);
}

Plymouth.SetQuitFunction(quit_callback);
