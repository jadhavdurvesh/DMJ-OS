#!/usr/bin/env bash
# dmj-ai — CLI entry point for DMJ OS's built-in Saudade AI assistant.
set -euo pipefail

VENV_PY="/opt/dmj-ai/venv/bin/python3"
INFER_SCRIPT="/opt/dmj-ai/dmj_ai_infer.py"

if [[ ! -x "$VENV_PY" ]]; then
  echo "dmj-ai: python environment not found at $VENV_PY" >&2
  echo "Did the build hook (0100-dmj-ai-setup.hook.chroot) run correctly?" >&2
  exit 1
fi

if [[ $# -eq 0 ]]; then
  echo "Usage: dmj-ai \"your prompt\" [--max-tokens N] [--temp T]"
  exit 1
fi

exec "$VENV_PY" "$INFER_SCRIPT" "$@"
